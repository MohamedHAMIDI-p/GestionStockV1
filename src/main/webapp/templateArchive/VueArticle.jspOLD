
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet"
      href="${pageContext.request.contextPath}/css/style.css">
    <title>Détails article</title>
</head>

<body>

<h1>Détails de l'article</h1>

<c:choose>

    <c:when test="${not empty article}">

        <table border="1" cellpadding="10">

            <tr>
                <th>Code article</th>
                <td><c:out value="${article.codeArticle}"/></td>
            </tr>

            <tr>
                <th>Désignation</th>
                <td><c:out value="${article.designation}"/></td>
            </tr>

            <tr>
                <th>Prix d'achat</th>
                <td><fmt:formatNumber value="${article.prixAchatArticle}" minFractionDigits="2"/></td>
            </tr>

            <tr>
                <th>Prix de vente</th>
                <td><fmt:formatNumber value="${article.prixVenteArticle}" minFractionDigits="2"/></td>
            </tr>

            <tr>
                <th>Prix de revient</th>
                <td><fmt:formatNumber value="${article.prixRevient}" minFractionDigits="2"/></td>
            </tr>

            <tr>
                <th>TVA</th>
                <td><c:out value="${article.tvaArticle}"/></td>
            </tr>

            <tr>
                <th>ID catégorie</th>
                <td><c:out value="${article.idCategory}"/></td>
            </tr>

            <tr>
                <th>ID fournisseur</th>
                <td><c:out value="${article.idFournisseur}"/></td>
            </tr>

            <tr>
                <th>Date création</th>
                <td><c:out value="${article.dateCreation}"/></td>
            </tr>

            <tr>
                <th>Date modification</th>
                <td><c:out value="${article.dateModification}"/></td>
            </tr>

        </table>

    </c:when>

    <c:otherwise>

        <p style="color:red;">
            <c:out value="${erreur}"/>
        </p>

    </c:otherwise>

</c:choose>

<br>

<a class="retour"
   href="${pageContext.request.contextPath}/articles">
    Retour à la liste
</a>

</body>
</html>
