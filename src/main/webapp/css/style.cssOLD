
/* Style général */
body {
    font-family: Arial, sans-serif;
    background-color: #f4f6f9;
    margin: 0;
    padding: 30px;
    color: #333;
}

/* Titre */
h1 {
    color: #2c3e50;
    margin-bottom: 25px;
}

/* Tableau */
table {
    width: 650px;
    border-collapse: collapse;
    background-color: white;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    overflow: hidden;
}

/* Cellules */
th, td {
    padding: 14px 18px;
    border-bottom: 1px solid #e5e7eb;
}

/* Colonne des titres */
th {
    width: 200px;
    background-color: #eaf0f6;
    color: #2c3e50;
    text-align: left;
}

/* Effet sur les lignes */
tr:hover {
    background-color: #f1f7ff;
}

/* Lien retour */
.retour {
    display: inline-block;
    margin-top: 25px;
    padding: 10px 18px;
    background-color: #2874a6;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}

.retour:hover {
    background-color: #1b4f72;
}